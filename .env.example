# Configure model routes as server-side secrets in Sites.
# MiniMax is the first dialogue route; failures fall through to configured free routes.
MINIMAX_API_KEY=
MINIMAX_MODEL=M2-her
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3.8-27b

# Optional paid fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Provider-neutral override for another Responses-compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_STYLE=responses
