# Configure model routes as server-side secrets in Sites.
# Free routes rotate after each successful generation. Keys are never sent to the browser.
SALON_ALLOW_PAID_FALLBACK=false
MINIMAX_API_KEY=
MINIMAX_MODEL=M2-her
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FREE_TIER_CONFIRMED=false
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3-8B
SILICONFLOW_FREE_CONFIRMED=false
MODELSCOPE_API_KEY=
MODELSCOPE_MODEL=Qwen/Qwen3-8B
MODELSCOPE_PUBLIC_USE_CONFIRMED=false
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3.8-27b
CLOUDFLARE_AI_FREE_TIER_CONFIRMED=false

# Optional paid fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Provider-neutral override for another Responses-compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_STYLE=responses
